# Toran DNS - Environment Variables

# ═══════════════════════════════════════════════════════════════
# FRONTEND (Firebase Hosting)
# ═══════════════════════════════════════════════════════════════
# No environment variables needed for the frontend.
# Firebase configuration is in firebase.js (client-safe, public API keys).
# Firestore rules are in firestore.rules.

# ═══════════════════════════════════════════════════════════════
# DNS SERVER (Node.js / Express)
# ═══════════════════════════════════════════════════════════════

# Server Port (required)
PORT=3000

# Upstream DNS Servers (required)
UPSTREAM_DNS=1.1.1.1
UPSTREAM_DNS_2=8.8.8.8

# Server Hostname (required)
HOSTNAME=dns.toran.app

# TLS for DoT (optional, default: false)
USE_TLS=false

# Firebase Service Account (required for Firestore access)
# Option 1: Set path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Option 2: Use default credentials (Cloud Run, GCP)
# No action needed - Firebase Admin SDK auto-detects

# ═══════════════════════════════════════════════════════════════
# DEPLOYMENT PLATFORMS
# ═══════════════════════════════════════════════════════════════

# Render (current deployment)
# - No special env vars needed beyond the above
# - Render auto-sets PORT

# Google Cloud Run
# - Uses default credentials (no GOOGLE_APPLICATION_CREDENTIALS needed)
# - Set region: asia-southeast1

# Fly.io
# - Set secrets: fly secrets set UPSTREAM_DNS=1.1.1.1
# - Use Dockerfile in server/

# Docker
# - Build: docker build -t toran-dns-server ./server
# - Run: docker run -p 3000:3000 -e PORT=3000 toran-dns-server
